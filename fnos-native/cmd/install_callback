#!/bin/bash
#
# Octop 本地版 — 安装后回调
# 将安装向导中输入的管理员/密钥配置写入 PKGVAR/.env，
# 启动器 bin/octop 会加载该 .env 完成前后端参数配置（非 Docker）。
#
set -euo pipefail

PKGVAR="${TRIM_PKGVAR:-/var/apps/octop-native/var}"
mkdir -p "$PKGVAR"
ENV_FILE="$PKGVAR/.env"

ADMIN_USER="${wizard_admin_username:-admin}"
ADMIN_PASS="${wizard_admin_password:-octop}"
LOG_LEVEL="${wizard_log_level:-info}"
OPENAI="${wizard_openai_api_key:-}"
DASHSCOPE="${wizard_dashscope_api_key:-}"

# 去除可能破坏 .env 格式的换行/引号
sanitize() { printf '%s' "$1" | tr -d '\n\r"'"'"''; }

ADMIN_USER=$(sanitize "$ADMIN_USER")
ADMIN_PASS=$(sanitize "$ADMIN_PASS")
LOG_LEVEL=$(sanitize "$LOG_LEVEL")
OPENAI=$(sanitize "$OPENAI")
DASHSCOPE=$(sanitize "$DASHSCOPE")

{
    echo "OCTOP_PORT=8088"
    echo "OCTOP_BIND_HOST=127.0.0.1"
    echo "OCTOP_LOG_LEVEL=${LOG_LEVEL}"
    echo "OCTOP_ADMIN_USERNAME=${ADMIN_USER}"
    echo "OCTOP_DEFAULT_PASSWORD=${ADMIN_PASS}"
    echo "OCTOP_ADMIN_DISPLAY_NAME=Admin"
    echo "OPENAI_API_KEY=${OPENAI}"
    echo "DASHSCOPE_API_KEY=${DASHSCOPE}"
} > "$ENV_FILE"

chmod 600 "$ENV_FILE"
echo "[octop-native] 已写入配置: $ENV_FILE" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true

# 尽力补装 Chromium 运行所需的系统共享库（浏览器自动化附加组件依赖）。
# 仅当以 root 运行且主机具备 apt 时执行；失败不影响安装流程。
if [ "$(id -u 2>/dev/null)" = "0" ] && command -v apt-get >/dev/null 2>&1; then
    echo "[octop-native] 正在补装 Chromium 系统依赖 ..." > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    apt-get update -y >/dev/null 2>&1 || true
    apt-get install -y --no-install-recommends \
        libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
        libdbus-1-3 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
        libxrandr2 libgbm1 libasound2 libpango-1.0-0 libcairo2 libatspi2.0-0 \
        libxshmfence1 libgtk-3-0 >/dev/null 2>&1 || true
fi

exit 0
