#!/bin/bash
#
# Octop 本地版（原生 app）— 生命周期管理
# 直接以进程方式运行在飞牛主机上（非 Docker）。
# start:  启动 bin/octop 启动器（后台，写 PID 文件）
# stop:   发送 SIGTERM，超时 SIGKILL
# status: 查询进程状态
#

APPDEST="${TRIM_APPDEST:-/var/apps/octop-native}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/octop-native/var}"
LOG_FILE="${PKGVAR}/info.log"
PID_FILE="${PKGVAR}/octop.pid"
PORT="${OCTOP_PORT:-8088}"
BIN="$APPDEST/bin/octop"

log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"; }

start_process() {
    if status; then return 0; fi
    mkdir -p "${PKGVAR}"
    log_msg "Starting Octop (native) ..."
    OCTOP_PORT="$PORT" "$BIN" >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"
    return 0
}

stop_process() {
    log_msg "Stopping Octop (native) ..."
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if kill -0 "${pid}" 2>/dev/null; then
            kill -TERM "${pid}"
            for i in $(seq 1 10); do
                sleep 1
                kill -0 "${pid}" 2>/dev/null || { rm -f "${PID_FILE}"; return 0; }
            done
            kill -KILL "${pid}"
        fi
        rm -f "${PID_FILE}"
    fi
    return 0
}

status() {
    [ -f "${PID_FILE}" ] && pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]') && kill -0 "${pid}" 2>/dev/null
}

case $1 in
    start)  start_process ;;
    stop)   stop_process ;;
    status) status && exit 0 || exit 3 ;;
    *)      exit 1 ;;
esac
